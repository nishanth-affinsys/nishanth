      stage("Trivy Scan"){
        container("utilities"){
          if(env.ACTION=='0' || env.ACTION=='1'){
          env.TRIVY_REPORT=sh(returnStdout: true, script: 'trivy  image  --ignore-unfixed  --input /trivy/image.tar > /trivy/trivy.txt && cat /trivy/trivy.txt')
          sh "cat /trivy/trivy.txt"
          office365ConnectorSend(
