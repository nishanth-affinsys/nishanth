

  def cmd(){
    String req_update_cmd = '/kaniko/executor \
                        --build-arg "GIT_TOKEN=${GIT_PASSWD}"\
                        --compressed-caching=true  --force \
                        --verbosity=info \
                        --dockerfile ./devops/Dockerfile \
                        --context=git://${GIT_PASSWD}@github.com/BankBuddy/${REPOSITORY_NAME}.git \
                        --git branch=${BRANCH} \
                        --destination=${IMAGE} \
                        --cleanup && mkdir /workspace'


      return req_update_cmd

  }

  String determineRepoName() {
      String reponame = scm.getUserRemoteConfigs()[0].getUrl().tokenize('/').last().split("\\.")[0]
      return reponame.toLowerCase();
  }



  node("kaniko-agent") {

    checkout scm
    env.RELEASE_VERSION=sh(returnStdout: true, script: 'git describe --tags').trim()

    env.TEAMS_WEBHOOK="https://affinsys.webhook.office.com/webhookb2/b8f1ee10-a1c2-41b2-9565-ae506ad2c257@ff6a797c-4692-4d8d-95cf-5f0481069b29/JenkinsCI/34756a6f3c144f509784e078201e3441/23d1354c-62e6-4d8d-b1ec-cbf1bd0430f5"

    env.BRANCH="${env.BRANCH_NAME}"
    env.REPOSITORY_NAME=determineRepoName()
    env.IMAGE="jed.ocir.io/axtz1rzlggn5/${REPOSITORY_NAME}:${RELEASE_VERSION}"

      stage('Start Build Notifier') {
