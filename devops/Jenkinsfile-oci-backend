                  def color = currentBuild.currentResult == 'SUCCESS' ? '#00FF00' : '#FF0000'
                  def buildNumber = "Build-Number: ${env.BUILD_NUMBER}"

                  office365ConnectorSend(
                      color: color,
                      status: status,
