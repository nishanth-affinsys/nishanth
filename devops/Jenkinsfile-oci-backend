          container("utilities"){
            withCredentials([usernamePassword(credentialsId: 'Pratham-GH', passwordVariable: 'GIT_PASSWD', usernameVariable: 'GIT_UNAME')]) {
              sh '''
                /workdir/helm_update.py -rn=live-deploy-oci --branch=dev --file_path=live-deploy-oci/services/${REPOSITORY_NAME}/values.yaml -t=${RELEASE_VERSION} -gt=${GIT_PASSWD} -cr=${REPOSITORY_NAME} --code_branch=${BRANCH} --update_env=yes && rm -rf live-deploy-oci && /workdir/helm_update.py -rn=live-deploy-oci --branch=live --file_path=live-deploy-oci/services/${REPOSITORY_NAME}/values.yaml -t=${RELEASE_VERSION} -gt=${GIT_PASSWD} -cr=${REPOSITORY_NAME} --code_branch=${BRANCH} --update_env=yes
