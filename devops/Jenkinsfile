podTemplate(yaml: '''
apiVersion: v1
kind: Pod
metadata:
  labels:
    jenkins/label-dynamic: "true"
spec:
  securityContext:
    fsGroup: 1000
  containers:
    - name: git
      image: alpine/git
      command:
      - cat
      tty: true
      volumeMounts:
      - name: workdir
        mountPath: /workdir
  volumes:
    - name: workdir
      emptyDir: {}
'''
) {
    node(POD_LABEL) {
        container('git'){
          stage('Checkout Repo') {
              dir('/workdir') {
                checkout scm
              }
          }

          stage('List Files') {
                  sh '''
                    ls -l
                    pwd
                '''
          }
        }
    }
}
