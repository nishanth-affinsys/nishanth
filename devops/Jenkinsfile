podTemplate(yaml: '''
apiVersion: v1
kind: Pod
metadata:
  labels:
    jenkins/label-dynamic: "true"
spec:
  securityContext:
    runAsUser: 0
    fsGroup: 0
  containers:
    - name: git
      image: alpine/git
      command:
      - cat
      tty: true
      volumeMounts:
      - name: workdir
        mountPath: /workdir
  volumes:
    - name: workdir
      emptyDir: {}
'''
) {
    node(POD_LABEL) {
        container('git'){
          stage('Checkout Repo') {
            checkout scm
            sh '''
              ls -l
              pwd
            '''
          }
        }
    }
}
