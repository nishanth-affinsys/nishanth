podTemplate(yaml: '''
apiVersion: v1
kind: Pod
metadata:
  labels:
    jenkins/label-dynamic: "true"
spec:
  securityContext:
    runAsUser: 0
    fsGroup: 0
  containers:
    - name: git
      image: alpine/git
      command: ["/bin/sh", "-c"]
      args: ["sleep 3600"]
      volumeMounts:
      - name: workdir
        mountPath: /workdir
  volumes:
    - name: workdir
      emptyDir: {}
'''
) {
    node(POD_LABEL) {
        container('git') {
            stage('Checkout and List') {
                dir('/workdir') {
                    checkout scm
                    sh '''
                      echo "Inside container"
                      ls -l
                      pwd
                    '''
                }
            }
        }
    }
}
