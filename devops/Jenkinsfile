podTemplate(yaml: '''
apiVersion: v1
kind: Pod
metadata:
  labels:
    jenkins/label-dynamic: "true"
spec:
  containers:
    - name: buildctl
      image: moby/buildkit:latest
      command:
      - cat
      tty: true
      env:
      - name: BUILDKIT_HOST
        value: tcp://buildkit.buildkit.svc.cluster.local:1234
      - name: DOCKER_CONFIG
        value: /root/.docker
      volumeMounts:
      - name: docker-config
        mountPath: /root/.docker
    - name: git
      image: alpine/git:latest
      command:
      - cat
      tty: true
      securityContext:
        runAsUser: 0
        runAsGroup: 0
  volumes:
    - name: docker-config
      emptyDir: {}
'''
) {
    node(POD_LABEL) {
        container('buildctl') {
            stage('Checkout And Build Image') {
                checkout scm
                
                withCredentials([usernamePassword(
                    credentialsId: 'docker-creds',
                    usernameVariable: 'USERNAME',
                    passwordVariable: 'PASSWORD'
                )]) {
                    sh '''
                        # Create Docker config for authentication
                        mkdir -p /root/.docker
                        cat > /root/.docker/config.json <<EOF
{
  "auths": {
    "https://index.docker.io/v1/": {
      "auth": "$(echo -n "${USERNAME}:${PASSWORD}" | base64 -w 0)"
    }
  }
}
EOF
                        
                        # Verify BuildKit connection
                        buildctl debug workers
                        
                        # Build and push with BuildKit
                        buildctl build \
                          --frontend dockerfile.v0 \
                          --local context=${WORKSPACE} \
                          --local dockerfile=${WORKSPACE} \
                          --output type=image,name=nishanthveeru/jenkins-demo:${BUILD_NUMBER},push=true \
                          --export-cache type=registry,ref=nishanthveeru/jenkins-demo-cache:buildcache,mode=max \
                          --import-cache type=registry,ref=nishanthveeru/jenkins-demo-cache:buildcache
                        
                        echo "Successfully built and pushed: nishanthveeru/jenkins-demo:${BUILD_NUMBER}"
                    '''
                }
            }
        }
        
        container('git') {
            stage('Clone Repo and Update YAML') {
                withCredentials([usernamePassword(
                    credentialsId: 'github-creds',
                    usernameVariable: 'GIT_USERNAME',
                    passwordVariable: 'GIT_TOKEN'
                )]) {
                    sh '''
                        git clone --branch test-jenkins --single-branch https://github.com/nishanth-affinsys/nishanth.git repo
                        cd repo
                        git config user.name "nishanth-affinsys"
                        git config user.email "nishanth.hg@affinsys.com"
                        
                        ./update.sh ./pod.yaml ${BUILD_NUMBER}
                        
                        git add .
                        git commit -m "artifact update: ${BUILD_NUMBER}"
                        git push https://${GIT_USERNAME}:${GIT_TOKEN}@github.com/nishanth-affinsys/nishanth.git test-jenkins
                    '''
                }
            }
        }
    }
}
