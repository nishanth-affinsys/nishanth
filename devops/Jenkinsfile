podTemplate(yaml: '''
apiVersion: v1
kind: Pod
metadata:
  labels:
    jenkins/label-dynamic: "true"
spec:
  containers:
    - name: kaniko
      image: gcr.io/kaniko-project/executor:debug
      command:
      - /bin/sh
      - -c
      - sleep 3600
      volumeMounts:
      - name: kaniko-workdir
        mountPath: /workspace
      - name: docker-config
        mountPath: /kaniko/.docker
      securityContext:
        runAsUser: 0
        runAsGroup: 0
        fsGroup: 0
  volumes:
    - name: kaniko-workdir
      emptyDir: {}
    - name: docker-config
      emptyDir: {}
'''
) {
    node(POD_LABEL) {
        container('kaniko') {
            stage('Checkout And Build Image') {
                dir('/workspace') {
                    checkout scm

                    withCredentials([usernamePassword(
                        credentialsId: 'docker-creds',
                        usernameVariable: 'USERNAME',
                        passwordVariable: 'PASSWORD'
                    )]) {
                        sh '''
                            mkdir -p /kaniko/.docker
                            cat > /kaniko/.docker/config.json <<EOF
{
  "auths": {
    "https://index.docker.io/v1/": {
      "auth": "$(echo -n "${USERNAME}:${PASSWORD}" | base64 -w 0)"
    }
  }
}
EOF
                        '''
                    }

                    sh '''
                        /kaniko/executor \
                          --context=/workspace \
                          --dockerfile=/workspace/devops/Dockerfile \
                          --destination=nishanthveeru/jenkins-demo:${BUILD_NUMBER} \
                          --cache=true \
                          --cache-repo=nishanthveeru/jenkins-demo-cache
                    '''
                }
            }
        }
    }
}