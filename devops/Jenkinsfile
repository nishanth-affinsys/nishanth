podTemplate(yaml: '''
apiVersion: v1
kind: Pod
metadata:
  labels:
    jenkins/label-dynamic: "true"
spec:
  containers:
    - name: buildkit
      image: moby/buildkit:latest
      command:
      - buildkitd
      args:
      - --addr
      - unix:///run/buildkit/buildkitd.sock
      - --addr
      - tcp://0.0.0.0:1234
      securityContext:
        privileged: true
      readinessProbe:
        exec:
          command:
          - buildctl
          - debug
          - workers
        initialDelaySeconds: 5
        periodSeconds: 5
      volumeMounts:
      - name: buildkit-socket
        mountPath: /run/buildkit
    - name: buildctl
      image: moby/buildkit:latest
      command:
      - cat
      tty: true
      env:
      - name: BUILDKIT_HOST
        value: unix:///run/buildkit/buildkitd.sock
      volumeMounts:
      - name: buildkit-socket
        mountPath: /run/buildkit
    - name: git
      image: alpine/git:latest
      command:
      - cat
      tty: true
      securityContext:
        runAsUser: 0
        runAsGroup: 0
  volumes:
    - name: buildkit-socket
      emptyDir: {}
'''
) {
    node(POD_LABEL) {
        container('buildctl') {
            stage('Checkout And Build Image') {
                checkout scm
                
                withCredentials([usernamePassword(
                    credentialsId: 'docker-creds',
                    usernameVariable: 'USERNAME',
                    passwordVariable: 'PASSWORD'
                )]) {
                    sh '''
                        # Wait for BuildKit daemon to be ready
                        until buildctl debug workers; do
                            echo "Waiting for BuildKit daemon..."
                            sleep 2
                        done
                        
                        # Login to Docker registry
                        echo "${PASSWORD}" | buildctl build \
                          --frontend gateway.v0 \
                          --opt source=docker/dockerfile \
                          --local context=${WORKSPACE} \
                          --local dockerfile=${WORKSPACE} \
                          --output type=image,name=nishanthveeru/jenkins-demo:${BUILD_NUMBER},push=true,registry.insecure=false \
                          --export-cache type=registry,ref=nishanthveeru/jenkins-demo-cache:buildcache,mode=max \
                          --import-cache type=registry,ref=nishanthveeru/jenkins-demo-cache:buildcache \
                          --opt build-arg:DOCKER_USER=${USERNAME} \
                          --opt build-arg:DOCKER_PASS=${PASSWORD}
                    '''
                }
            }
        }
        
        container('git') {
            stage('Clone Repo and Update YAML') {
                withCredentials([usernamePassword(
                    credentialsId: 'github-creds',
                    usernameVariable: 'GIT_USERNAME',
                    passwordVariable: 'GIT_TOKEN'
                )]) {
                    sh '''
                        git clone --branch test-jenkins --single-branch https://github.com/nishanth-affinsys/nishanth.git repo
                        cd repo
                        git config user.name "nishanth-affinsys"
                        git config user.email "nishanth.hg@affinsys.com"
                        
                        ./update.sh ./pod.yaml ${BUILD_NUMBER}
                        
                        git add .
                        git commit -m "artifact update: ${BUILD_NUMBER}"
                        git push https://${GIT_USERNAME}:${GIT_TOKEN}@github.com/nishanth-affinsys/nishanth.git test-jenkins
                    '''
                }
            }
        }
    }
}
''')
