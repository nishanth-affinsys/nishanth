podTemplate(yaml: '''
apiVersion: v1
kind: Pod
metadata:
  labels:
    jenkins/label-dynamic: "true"
spec:
  containers:
    - name: git
      image: alpine/git
      command:
      - cat
      tty: true
'''
) {
    node(POD_LABEL) {
        container('git'){
          stage('Checkout Repo') {
              checkout scm
          }

          stage('List Files') {
                  sh 'ls -l'
          }
        }
    }
}
