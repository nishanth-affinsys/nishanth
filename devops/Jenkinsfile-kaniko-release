def generateReleaseBuildCMD(image,context){
    String cmd = "/kaniko/executor \
                 --build-arg GIT_TOKEN=\${GIT_PASSWD} \
                 --compressed-caching=true  \
                 --force --verbosity=info --dockerfile ./devops/Dockerfile \
                 --context=${context} --git branch=\${RELEASE_VERSION} \
                 --tar-path=/trivy/image.tar --destination=${image}"
  return cmd
}

def generateDeployCommands(server_ip,server_uname,deploy_cmd){
    String cmd = """ssh -o StrictHostKeyChecking=no ${server_uname}@${server_ip} ${deploy_cmd}""" 
    return cmd
}

String determineRepoName() {
    String reponame = scm.getUserRemoteConfigs()[0].getUrl().tokenize('/').last().split("\\.")[0]
    return reponame.toLowerCase();
}


