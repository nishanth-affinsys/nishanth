# SECURITY WARNING: don't run with debug turned on in production!
DEBUG=False
#Allowed Hosts for the application this is a comma seperated value
ALLOWED_HOSTS=*
DEFAULT_LOCALE=en_US
SUPPORTED_LOCALES=en_US
# Internationalization
LANGUAGE_CODE=en-us
TIME_ZONE=UTC
USE_I18N=True
USE_L10N=True
USE_TZ=True

# How to set Tenants ?
# Please set first tenant name as default
# TENANTS variable needs to be set as comma seperated
# In database {tenant} means you need to replace your tenant value inplace of {tenant}

#Database Middleware Setting, Keep false for dynamic-db
USE_DATABASE_AS_DEFAULT=False

# Databases
TENANTS=default,handoff,analytics,campaign,complaints,onboarding,profile,kyc,transaction,llm,notification,etbprovider,botbuilder,accounting,accessory,merchant

#backup-tenants=,default_backup,handoff_backup,analytics_backup,campaign_backup,complaints_backup,onboarding_backup,profile_backup,kyc_backup,transaction_backup,llm_backup,notification_backup,etbprovider_backup,botbuilder_backup,accounting_backup,accessory_backup,merchant_backup
#oracle tenants
#TENANTS=default,handoff,analytics,campaign,,onboarding,profile,notification

# Available  DB engine options
#     DB_ENGINE       = Set of env's Required
#
# oracle_easy_connect = DB_ENGINE , DB_NAME , DB_USER, DB_PASSWORD
#
# oracle_full_connect = DB_ENGINE, DB_PROTOCOL, DB_PORT, DB_HOST,
#                       DB_SERVICE_NAME, DB_USER, DB_PASSWORD
#
# oracle              = DB_ENGINE, DB_HOST, DB_PORT, DB_NAME, DB_USER
#                       DB_PASSWORD
#
# postgres_schema     = DB_ENGINE, DB_HOST, DB_PORT, DB_NAME, DB_USER,
#                       DB_PASSWORD, DB_SCHEMA_{tenant}
#
# postgres_schema_ssl = DB_ENGINE, DB_HOST, DB_PORT, DB_NAME, DB_USER,
#                       DB_PASSWORD, DB_SCHEMA_{tenant}
#
# sqlite              = DB_ENGINE

DB_PROTOCOL=${DB_PROTOCOL}
DB_SERVICE_NAME=${DB_SERVICE_NAME}
DB_ENGINE_default=${DB_ENGINE}
#DB_ENGINE=oracle

#Dynamic db conf, keep false to not read from Client metadata
USE_DYNAMIC_DB_CONF=False

