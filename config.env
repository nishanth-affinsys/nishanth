#DB_SCHEMA_clickstream=clickstream
DB_SCHEMA_complaints=complaint
DB_SCHEMA_etbprovider=etbprovider
DB_SCHEMA_handoff=handoff
DB_SCHEMA_kyc=kyc
DB_SCHEMA_llm=llm
DB_SCHEMA_notification=notification
DB_SCHEMA_onboarding=onboarding
