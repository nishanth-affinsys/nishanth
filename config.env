# Cross Origin
CORS_ORIGIN_ALLOW_ALL=False

# Redis Tracker Configs
USE_REDIS=False

# Celery Configurations
USE_CELERY=False

# Event Logger Configurations
USE_EVENT_LOGGER=False

# Cache Settings
USE_CACHE=True
CACHE_LOCATION=redis://${REDIS_HOST_ANALYTICS}:${REDIS_PORT_ANALYTICS}/1
CACHE_BACKEND=django_redis.cache.RedisCache
CACHE_TIMEOUT=300

# Minio Config
USE_MINIO_INTERNAL_CLIENT=False

USE_MINIO_EXTERNAL_CLIENT=False

# API Request Logging Settings
SERVICE_NAME=analytics

REQUEST_LOGGING_SENSITIVE_HEADERS=
REQUEST_LOGGING_SENSITIVE_POST_PARAMS=
RESPONSE_LOGGING_SENSITIVE_HEADERS=
RESPONSE_LOGGING_SENSITIVE_BODY_PARAMS=
USE_API_REQ_LOGGING=True
LOG_ACTIVITY_PUBSUB=True

# APIClient Settings
DEFAULT_REQUEST_TIMEOUT=5

MAX_PER_PAGE=10
MAX_PDF_LIMIT=1000
TEMPLATE_PATH=/main/Templates/

KOMBU_BROKER_URL=amqp://${QUEUE_USER}:${QUEUE_PASSWORD}@${QUEUE_HOST}:5672
USE_QUORUM_QUEUES=False

LOGGING_HANDLERS=console
LOGGING_COLORIZE=True
EXCEPTION_DIAGNOSIS=False

#metadata
ENVIRONMENT=${ENVIRONMENT}
REF_SPEC_STRING=refs/heads/{branch}:refs/heads/{branch}
DEFAULT_BRANCH=master
GIT_USER=${GIT_USER}
GIT_EMAIL=${GIT_EMAIL}
GIT_TOKEN=${GIT_TOKEN}
CLONE_DIR=client_metadata
DESIRED_METADATA_OBJECTS=project_metadata,system_conf,exceptions_conf
USE_SERVICE_DEFAULTS=True
USE_METADATA=True
STASH_BEFORE_PULL=True
EXCLUDE_CALLBACKS_PERMISSIONS=True
USE_MESSAGE_QUEUE=True
FULL_LOADER_INTERVAL=1
DESIRED_UNLOAD_OBJECTS=
USE_ERROR_DEFAULTS=True

#auth envs
ALLOWED_USER_TYPES=internal,wallet-customer,merchant
PERMISSION_CATEGORY_NAME=analytics
PERMISSION_FILE_PATH=permissions.json

INTERNAL_REFRESH_API=http://${INTERNAL_PROVIDER_HOST}:${INTERNAL_PROVIDER_PORT}/internal-users/permission/refresh/
AGENT_REFRESH_API=http://${AGENT_PROVIDER_HOST}:${AGENT_PROVIDER_PORT}/agents/permission/refresh/
MERCHANT_REFRESH_API=http://${MERCHANT_PROVIDER_HOST}:${MERCHANT_PROVIDER_PORT}/merchants/permission/refresh/
ETB_CUSTOMER_REFRESH_API=http://${CUSTOMER_PROVIDER_HOST}:${CUSTOMER_PROVIDER_HOST}/etbprovider/permission/refresh/
NTB_CUSTOMER_REFRESH_API=http://${NTB_CUSTOMER_PROVIDER_HOST}:${NTB_CUSTOMER_PROVIDER_PORT}/ntb-customers/permission/refresh/
WALLET_CUSTOMER_REFRESH_API=http://${WALLET_CUSTOMER_PROVIDER_HOST}:${WALLET_CUSTOMER_PROVIDER_PORT}/wallet-customers/permission/refresh/
EVENTLOGGER_SCHEDULE_UPDATE=http://${EVENTLOGGER_HOST}:${EVENTLOGGER_PORT}/events/schedule/
INTERNAL_PERMISSIONS_API=http://${INTERNAL_PROVIDER_HOST}:${INTERNAL_PROVIDER_PORT}/internal-users/get-current-user-details/?permissions=true
STUB_INTERNAL_PERMISSIONS_API=False

PICSUM_URL=http://${PICSUM_HOST}:${PICSUM_PORT}/picsumsvc/generate/pdf/

LOGLEVEL=DEBUG
LOG_INTO_FILE=False
LOG_WITH_COLOR_IN_CONSOLE=True
LOG_WITH_COLOR_IN_FILE=False
LOG_BACKUP=100
LOG_WHEN=W0
LOG_FILE_NAME=analytics.log

#customer wallet app envs
PAYMENT_CATEGORY_QR=QRPAY
#merchant wallet env
TRANSACTION_ABANDON_TIMEOUT=${TRANSACTION_ABANDON_TIMEOUT}

#offset envs
USE_OFFSET=True

#onboarding
ENABLE_BRANCH_FILTER=False

#publishing to eventlogger
ANALYTICS_BROKER_URL=amqp://${QUEUE_USER}:${QUEUE_PASSWORD}@${QUEUE_HOST}:5672
ENABLE_PUBLISHER_CONFIRMS=False


#task lib
TASK_BACKEND=celery
CELERY_BROKER_URL=redis://${REDIS_HOST_ANALYTICS}:${REDIS_PORT_ANALYTICS}/1


#cta limit
MAX_CTA_TIME_LIMIT=30

#metadata
SKIP_REMOTE_ACTIONS=False
USE_BULK_CACHE=True

#DNS
DNS=${DNS}

#Views Schedule
TIME_SKIP_VIEWS=5

#s3client envs
USE_S3_INTERNAL_CLIENT=True
S3_INTERNAL_HOST_URL=http://${MINIO_HOST}:${MINIO_PORT}
S3_ACCESS_KEY=${MINIO_ACCESS_KEY}
S3_SECRET_KEY=${MINIO_SECRET_KEY}
DEFAULT_S3_LINK_EXPIRY_TIMEOUT=36000
USE_S3_EXTERNAL_CLIENT=True
S3_EXTERNAL_HOST_URL=https://${DNS}
MINIO_BUCKET_NAME=${MINIO_BUCKET_NAME}

#NATS
NATS_BROKER_URL=${NATS_HOST}:${NATS_PORT}
PUBSUB_BROKER=${PUBSUB_BROKER}

COMPLETION_SUBSCRIBERS=analytics
ANALYTICS_CALLBACK=http://${ANALYTICS_HOST}:${ANALYTICS_PORT}/analytics-new/reports/webhooks/schedule-complete/


